<a class="event-card-link" href="@($"/events/{EventId}")" aria-label="@($"View details for {EventName}")">
    <article class="event-card">
        <div class="date-tile" aria-label="@EventDate.ToString("MMMM d, yyyy")">
            <span class="date-month">@EventDate.ToString("MMM")</span>
            <span class="date-day">@EventDate.ToString("dd")</span>
            <span class="date-weekday">@EventDate.ToString("ddd")</span>
        </div>

        <div class="card-content">
            <p class="event-date">@EventDate.ToString("MMMM d, yyyy") <span>·</span> @EventDate.ToString("h:mm tt")</p>
            <h3>@EventName</h3>
            <p class="event-location">
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                    <path d="M16.25 8.33c0 4.38-6.25 9.17-6.25 9.17S3.75 12.71 3.75 8.33a6.25 6.25 0 1 1 12.5 0Z" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="10" cy="8.33" r="2.08" stroke="currentColor" stroke-width="1.5" />
                </svg>
                @Location
            </p>
        </div>

        <span class="card-arrow" aria-hidden="true">↗</span>
    </article>
</a>

@code {
    [Parameter, EditorRequired]
    public int EventId { get; set; }

    [Parameter, EditorRequired]
    public string EventName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public DateTime EventDate { get; set; }

    [Parameter, EditorRequired]
    public string Location { get; set; } = string.Empty;
}
